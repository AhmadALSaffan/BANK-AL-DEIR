<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/fatora_layout_anim"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:letterSpacing="0.15"
                android:text="FATORA"
                android:textColor="?attr/colorPrimary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="What are you paying?"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="Pick a category to continue."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!-- Government -->
            <LinearLayout
                android:id="@+id/cardGovernmentPayments"
                style="@style/FatoraMenuCard">

                <ImageView
                    style="@style/FatoraMenuIcon"
                    android:src="@drawable/ic_government"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/FatoraTitle" android:text="Government" />
                    <TextView style="@style/FatoraSub" android:text="Passport · ID · immigration fines" />
                </LinearLayout>

                <ImageView style="@style/CardOptionChevron" />
            </LinearLayout>

            <!-- Mobile -->
            <LinearLayout
                android:id="@+id/cardMobilePayments"
                style="@style/FatoraMenuCard">

                <ImageView
                    style="@style/FatoraMenuIcon"
                    android:src="@drawable/ic_mobile"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/FatoraTitle" android:text="Mobile" />
                    <TextView style="@style/FatoraSub" android:text="Pay bills · refill balance" />
                </LinearLayout>

                <ImageView style="@style/CardOptionChevron" />
            </LinearLayout>

            <!-- Electricity -->
            <LinearLayout
                android:id="@+id/cardElectricityPayments"
                style="@style/FatoraMenuCard">

                <ImageView
                    style="@style/FatoraMenuIcon"
                    android:src="@drawable/ic_electricity"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/FatoraTitle" android:text="Electricity" />
                    <TextView style="@style/FatoraSub" android:text="Pay your electricity bills" />
                </LinearLayout>

                <ImageView style="@style/CardOptionChevron" />
            </LinearLayout>

            <!-- University -->
            <LinearLayout
                android:id="@+id/cardUniversityPayments"
                style="@style/FatoraMenuCard">

                <ImageView
                    style="@style/FatoraMenuIcon"
                    android:src="@drawable/ic_university"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/FatoraTitle" android:text="University" />
                    <TextView style="@style/FatoraSub" android:text="Tuition · fines · hostel fees" />
                </LinearLayout>

                <ImageView style="@style/CardOptionChevron" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
