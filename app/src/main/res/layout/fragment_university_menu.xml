<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:layoutAnimation="@anim/fatora_layout_anim"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.15"
        android:text="FATORA"
        android:textColor="?attr/colorPrimary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="University"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:text="Pick what you'd like to pay."
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:id="@+id/cardTuition"
        style="@style/FatoraMenuCard">

        <ImageView
            style="@style/FatoraMenuIcon"
            android:src="@drawable/ic_student"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView style="@style/FatoraTitle" android:text="Tuition" />
            <TextView style="@style/FatoraSub" android:text="Pay your semester tuition" />
        </LinearLayout>

        <ImageView style="@style/CardOptionChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardFines"
        style="@style/FatoraMenuCard">

        <ImageView
            style="@style/FatoraMenuIcon"
            android:src="@drawable/ic_fine"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView style="@style/FatoraTitle" android:text="Fines" />
            <TextView style="@style/FatoraSub" android:text="Clear outstanding fines" />
        </LinearLayout>

        <ImageView style="@style/CardOptionChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardHostel"
        style="@style/FatoraMenuCard">

        <ImageView
            style="@style/FatoraMenuIcon"
            android:src="@drawable/ic_hostel"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView style="@style/FatoraTitle" android:text="Hostel fees" />
            <TextView style="@style/FatoraSub" android:text="Pay your accommodation fees" />
        </LinearLayout>

        <ImageView style="@style/CardOptionChevron" />
    </LinearLayout>

</LinearLayout>
