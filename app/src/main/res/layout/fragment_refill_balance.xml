<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/fatora_layout_anim"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refill balance"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="Top up credit on any line."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView style="@style/FatoraFieldLabel" android:text="Provider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardMTN"
                    style="@style/FatoraSelectCard"
                    android:layout_height="130dp"
                    android:layout_marginEnd="5dp">

                    <ImageView
                        android:id="@+id/mtnCheckIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="end"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="invisible"
                        app:tint="?attr/colorPrimary" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/mtn"
                        app:shapeAppearanceOverlay="@style/RoundSqaure" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="MTN"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardSyriatel"
                    style="@style/FatoraSelectCard"
                    android:layout_height="130dp"
                    android:layout_marginHorizontal="5dp">

                    <ImageView
                        android:id="@+id/syriatelCheckIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="end"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="invisible"
                        app:tint="?attr/colorPrimary" />

                    <ImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/syriatel" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Syriatel"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardSyrianTelecom"
                    style="@style/FatoraSelectCard"
                    android:layout_height="130dp"
                    android:layout_marginStart="5dp">

                    <ImageView
                        android:id="@+id/syrianTelecomCheckIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="end"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="invisible"
                        app:tint="?attr/colorPrimary" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/syrian_telecom"
                        app:shapeAppearanceOverlay="@style/RoundSqaure" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Syrian Telecom"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/FatoraFieldLabel" android:text="Mobile number" />

            <EditText
                android:id="@+id/mobileNumberEditText"
                style="@style/FatoraInput"
                android:drawableStart="@drawable/ic_phone"
                android:hint="Enter mobile number"
                android:inputType="phone" />

            <TextView style="@style/FatoraFieldLabel" android:text="Amount" />

            <EditText
                android:id="@+id/amountEditText"
                style="@style/FatoraInput"
                android:drawableStart="@drawable/ic_money"
                android:hint="Top-up amount"
                android:inputType="numberDecimal" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/continueButton"
        style="@style/Widget.BankALDeir.Button"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:text="Continue to payment"
        app:cornerRadius="14dp" />

</LinearLayout>
