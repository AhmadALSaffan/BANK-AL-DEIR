<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/optionsSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_type_bg"
    android:orientation="vertical">

    <!-- Oxblood cap -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/oxblood_cap_top"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="22dp"
        android:paddingBottom="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.16"
            android:text="MANAGE CARD"
            android:textColor="@color/enamel_brass_light"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Card options"
            android:textColor="@color/porcelain_bright"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtDialogCardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:text="•••• 1234"
            android:textColor="#D9F1E7D2"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Body -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:id="@+id/optionTransfer"
            style="@style/CardOptionRow">

            <ImageView
                style="@style/CardOptionIcon"
                android:src="@drawable/ic_send_transfer"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView style="@style/CardOptionTitle" android:text="Add money to this card" />

                <TextView style="@style/CardOptionSub" android:text="Move funds from your balance or another card" />
            </LinearLayout>

            <ImageView style="@style/CardOptionChevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optionMain"
            style="@style/CardOptionRow">

            <ImageView
                android:id="@+id/imgMainIcon"
                style="@style/CardOptionIcon"
                android:src="@drawable/ic_star"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtMainLabel"
                    style="@style/CardOptionTitle"
                    android:text="Set as main card" />

                <TextView
                    android:id="@+id/txtMainSubLabel"
                    style="@style/CardOptionSub"
                    android:text="Show your main balance on this card" />
            </LinearLayout>

            <ImageView style="@style/CardOptionChevron" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp" />

        <LinearLayout
            android:id="@+id/optionPin"
            style="@style/CardOptionRow">

            <ImageView
                style="@style/CardOptionIcon"
                android:src="@drawable/ic_key"
                app:tint="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtPinOptionLabel"
                    style="@style/CardOptionTitle"
                    android:text="Create PIN" />

                <TextView style="@style/CardOptionSub" android:text="Protect this card with a 4-digit PIN" />
            </LinearLayout>

            <ImageView style="@style/CardOptionChevron" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/optionLock"
            style="@style/CardOptionRow">

            <ImageView
                android:id="@+id/imgLockIcon"
                style="@style/CardOptionIcon"
                android:src="@drawable/ic_lock"
                app:tint="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtLockLabel"
                    style="@style/CardOptionTitle"
                    android:text="Lock card" />

                <TextView
                    android:id="@+id/txtLockSubLabel"
                    style="@style/CardOptionSub"
                    android:text="Temporarily block transactions" />
            </LinearLayout>

            <ImageView style="@style/CardOptionChevron" />
        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="6dp" />

        <LinearLayout
            android:id="@+id/optionDelete"
            style="@style/CardOptionRow">

            <ImageView
                style="@style/CardOptionIcon"
                android:src="@drawable/ic_trash"
                app:tint="?attr/colorError" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete card"
                    android:textColor="?attr/colorError"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView style="@style/CardOptionSub" android:text="Permanently remove this card" />
            </LinearLayout>

            <ImageView style="@style/CardOptionChevron" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelOptions"
            style="@style/Widget.BankALDeir.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Close"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</LinearLayout>
