<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:layoutAnimation="@anim/fatora_layout_anim"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:letterSpacing="0.15"
        android:text="FATORA"
        android:textColor="?attr/colorPrimary"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Government"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:text="Choose a government service."
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:id="@+id/cardNewPassport"
        style="@style/FatoraMenuCard">

        <ImageView
            style="@style/FatoraMenuIcon"
            android:src="@drawable/ic_passport"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView style="@style/FatoraTitle" android:text="New passport" />
            <TextView style="@style/FatoraSub" android:text="Apply and pay the issuance fee" />
        </LinearLayout>

        <ImageView style="@style/CardOptionChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardNewId"
        style="@style/FatoraMenuCard">

        <ImageView
            style="@style/FatoraMenuIcon"
            android:src="@drawable/ic_id_card"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView style="@style/FatoraTitle" android:text="New ID card" />
            <TextView style="@style/FatoraSub" android:text="Pay for a replacement ID" />
        </LinearLayout>

        <ImageView style="@style/CardOptionChevron" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/cardImmigrationFine"
        style="@style/FatoraMenuCard">

        <ImageView
            style="@style/FatoraMenuIcon"
            android:src="@drawable/ic_government"
            app:tint="?attr/colorPrimary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView style="@style/FatoraTitle" android:text="Immigration fine" />
            <TextView style="@style/FatoraSub" android:text="Settle an immigration fine" />
        </LinearLayout>

        <ImageView style="@style/CardOptionChevron" />
    </LinearLayout>

</LinearLayout>
