<?xml version="1.0" encoding="utf-8"?>
<!-- Home promo card. Portrait tile, full-bleed Firebase image, title top-left over a
     scrim. Petrol enamel shows through when there is no image. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adCard"
    android:layout_width="142dp"
    android:layout_height="164dp"
    android:layout_marginEnd="12dp"
    app:cardBackgroundColor="@color/enamel_petrol"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/enamel_keyline"
    app:strokeWidth="1.5dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/adImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="88dp"
            android:layout_gravity="top"
            android:background="@drawable/ad_scrim_top" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/adTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:lineSpacingMultiplier="0.98"
                android:maxLines="2"
                android:text="Title"
                android:textColor="@color/porcelain_bright"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/adSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Subtitle"
                android:textColor="#D9F1E7D2"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
