<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/fatora_layout_anim"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="University fines"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView style="@style/FatoraFieldLabel" android:text="University" />

            <TextView
                android:id="@+id/universityNameTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="—"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView style="@style/FatoraFieldLabel" android:text="Student number" />

            <EditText
                android:id="@+id/studentNumberEditText"
                style="@style/FatoraInput"
                android:drawableStart="@drawable/ic_student"
                android:hint="Enter your student number"
                android:inputType="number" />

            <TextView style="@style/FatoraFieldLabel" android:text="Amount" />

            <EditText
                android:id="@+id/amountEditText"
                style="@style/FatoraInput"
                android:drawableStart="@drawable/ic_money"
                android:hint="Fine amount"
                android:inputType="numberDecimal" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/continueButton"
        style="@style/Widget.BankALDeir.Button"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:text="Continue to payment"
        app:cornerRadius="14dp" />

</LinearLayout>
