<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backsy"
    tools:context=".FatoraMain">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <FrameLayout
                android:id="@+id/frame"
                android:layout_width="350dp"
                android:layout_height="200dp"
                android:layout_gravity="center"
                android:layout_marginTop="25dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/backwhite"
                    app:shapeAppearanceOverlay="@style/RoundSqaure" />

                <ImageView
                    android:id="@+id/bankIconImageView"
                    android:layout_width="wrap_content"
                    android:layout_height="150dp"
                    android:layout_marginTop="25dp"
                    android:contentDescription="Bank Icon"
                    app:srcCompat="@drawable/iconbank" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/fatoraBannerImageView"
                    android:layout_width="350dp"
                    android:layout_height="200dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="20dp"
                    android:contentDescription="Fatora Banner"
                    android:src="@drawable/fatorabanner" />

                <Button
                    android:id="@+id/btnPay"
                    android:layout_width="350dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/btnpay"
                    android:drawableStart="@drawable/fatpay"
                    android:drawablePadding="12dp"
                    android:drawableTint="@color/white"
                    android:gravity="center"
                    android:paddingStart="50dp"
                    android:paddingEnd="100dp"
                    android:text="PAY"
                    android:textColor="@color/white"
                    android:textSize="24sp" />


                <Button
                    android:id="@+id/btnIssue"
                    android:layout_width="350dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/btnissue"
                    android:drawableLeft="@drawable/fatissue"
                    android:drawableTint="@color/white"
                    android:paddingStart="50dp"
                    android:paddingEnd="100dp"
                    android:text="ISSUE"
                    android:textColor="@color/white"
                    android:textSize="24sp" />

                <Button
                    android:id="@+id/btnCheck"
                    android:layout_width="350dp"
                    android:layout_height="60dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/btncehck"
                    android:drawableLeft="@drawable/fatcheck"
                    android:drawableTint="@color/white"
                    android:paddingStart="50dp"
                    android:paddingEnd="100dp"
                    android:text="Check"
                    android:textColor="@color/white"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="40dp"
                    android:text="© 2025 Bank Al-Dier | Secured by Fatora"
                    android:textColor="@color/white"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
