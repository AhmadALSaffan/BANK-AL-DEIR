<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".Fatora.UI.FatoraMain">

    <ImageView
        android:id="@+id/btnBack"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="46dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/back"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="Fatora"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- Oxblood enamel hero plaque -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/enamel_plaque_oxblood"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="132dp"
            android:layout_height="50dp"
            android:contentDescription="Fatora"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/RoundSqaure"
            app:srcCompat="@drawable/fatora" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.14"
            android:text="BILL PAYMENTS"
            android:textColor="@color/enamel_brass_light"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Pay your bills"
            android:textColor="@color/porcelain_bright"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="Government services, university fees, mobile top-ups and electricity — all paid from your balance."
            android:textColor="#D9F1E7D2"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- What you can pay -->
    <TextView
        android:id="@+id/payLegend"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:letterSpacing="0.15"
        android:text="WHAT YOU CAN PAY"
        android:textColor="?attr/colorPrimary"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hero" />

    <LinearLayout
        android:id="@+id/categoryStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="14dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/payLegend">

        <LinearLayout style="@style/FatoraCategoryCell">
            <ImageView style="@style/FatoraCategoryIcon" android:src="@drawable/ic_government" app:tint="?attr/colorPrimary" />
            <TextView style="@style/FatoraCategoryLabel" android:text="Government" />
        </LinearLayout>

        <LinearLayout style="@style/FatoraCategoryCell">
            <ImageView style="@style/FatoraCategoryIcon" android:src="@drawable/ic_university" app:tint="?attr/colorPrimary" />
            <TextView style="@style/FatoraCategoryLabel" android:text="University" />
        </LinearLayout>

        <LinearLayout style="@style/FatoraCategoryCell">
            <ImageView style="@style/FatoraCategoryIcon" android:src="@drawable/ic_mobile" app:tint="?attr/colorPrimary" />
            <TextView style="@style/FatoraCategoryLabel" android:text="Mobile" />
        </LinearLayout>

        <LinearLayout style="@style/FatoraCategoryCell">
            <ImageView style="@style/FatoraCategoryIcon" android:src="@drawable/ic_electricity" app:tint="?attr/colorPrimary" />
            <TextView style="@style/FatoraCategoryLabel" android:text="Electricity" />
        </LinearLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPay"
        style="@style/Widget.BankALDeir.Button"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="104dp"
        android:text="Pay a bill"
        android:textSize="17sp"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_payment"
        app:iconGravity="textStart"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Floating bottom nav (shared) -->
    <include
        layout="@layout/floating_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="18dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
