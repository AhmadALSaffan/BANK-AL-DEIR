<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backsy"
    android:orientation="vertical"
    tools:context=".Fatora.UI.FatoraMain">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeaderTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bank Al-Dier"
                        android:textColor="#FFFFFF"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02" />

                    <TextView
                        android:id="@+id/tvHeaderSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Secure Payment Portal"
                        android:textColor="#7a9e8e"
                        android:textSize="13sp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/ic_bg_income">
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/iconbank"
                        app:tint="#4edea3" />
                </FrameLayout>
            </LinearLayout>

            <!-- Banner Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardContainer"
                android:layout_width="match_parent"
                android:layout_height="210dp"
                android:layout_marginTop="28dp"
                app:cardBackgroundColor="#0a1f17"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/fatoraBannerImageView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/fatorabanner"
                        android:alpha="0.18"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <!-- Emerald glow line at top -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:background="#4edea3"
                        android:alpha="0.6"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Bank icon top-left -->
                    <ImageView
                        android:id="@+id/bankIconImageView"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_margin="20dp"
                        android:background="@drawable/ic_bg_income"
                        android:padding="9dp"
                        app:srcCompat="@drawable/iconbank"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- "FATORA" label top-right -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="20dp"
                        android:text="FATORA"
                        android:textColor="#4edea3"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.15"
                        android:alpha="0.8"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Card number bottom -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="16dp"
                        android:text="**** **** **** 8842"
                        android:textColor="#FFFFFF"
                        android:textSize="17sp"
                        android:letterSpacing="0.1"
                        android:fontFamily="monospace"
                        app:layout_constraintBottom_toTopOf="@+id/cardTypeLabel"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/cardTypeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="20dp"
                        android:layout_marginBottom="20dp"
                        android:text="Payment Card"
                        android:textColor="#7a9e8e"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!-- Chip-style icon bottom-right -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="20dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <View
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/ic_mastercard" />
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:id="@+id/buttonsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnPay"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/btnedit"
                    android:text="Pay Now"
                    android:textColor="#0a1f17"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/fatpay"
                    android:drawableTint="#0a1f17"
                    android:drawablePadding="12dp"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:gravity="center_vertical|start"
                    android:elevation="4dp"
                    tools:ignore="RtlCompat" />

                <Button
                    android:id="@+id/btnCheck"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/card_type_bg"
                    android:text="Check Status"
                    android:textColor="#4edea3"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:drawableStart="@drawable/fatcheck"
                    android:drawableTint="#4edea3"
                    android:drawablePadding="12dp"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:gravity="center_vertical|start"
                    tools:ignore="RtlCompat" />

            </LinearLayout>

            <!-- Footer -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="36dp"
                android:text="© 2026 Bank Al-Dier | Secured by Fatora"
                android:textColor="#7a9e8e"
                android:textSize="11sp"
                android:alpha="0.7" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
