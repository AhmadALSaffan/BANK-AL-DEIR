<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_type_bg"
    android:orientation="vertical">

    <!-- Oxblood cap -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/oxblood_cap_top"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="CARD SECURITY"
            android:textColor="@color/enamel_brass_light"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPinDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Create PIN"
            android:textColor="@color/porcelain_bright"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- PIN dots, framed as a display field on the plaque -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/pin_dots_field"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="26dp"
            android:paddingVertical="16dp">

            <ImageView
                android:id="@+id/pinDot1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="9dp"
                android:contentDescription="@null"
                android:src="@drawable/pin_circle_empty" />

            <ImageView
                android:id="@+id/pinDot2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="9dp"
                android:contentDescription="@null"
                android:src="@drawable/pin_circle_empty" />

            <ImageView
                android:id="@+id/pinDot3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="9dp"
                android:contentDescription="@null"
                android:src="@drawable/pin_circle_empty" />

            <ImageView
                android:id="@+id/pinDot4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginHorizontal="9dp"
                android:contentDescription="@null"
                android:src="@drawable/pin_circle_empty" />
        </LinearLayout>
    </LinearLayout>

    <!-- Body: disc keypad -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button android:id="@+id/btn1" style="@style/PinDialogDisc" android:text="1" />

            <Button android:id="@+id/btn2" style="@style/PinDialogDisc" android:text="2" />

            <Button android:id="@+id/btn3" style="@style/PinDialogDisc" android:text="3" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button android:id="@+id/btn4" style="@style/PinDialogDisc" android:text="4" />

            <Button android:id="@+id/btn5" style="@style/PinDialogDisc" android:text="5" />

            <Button android:id="@+id/btn6" style="@style/PinDialogDisc" android:text="6" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button android:id="@+id/btn7" style="@style/PinDialogDisc" android:text="7" />

            <Button android:id="@+id/btn8" style="@style/PinDialogDisc" android:text="8" />

            <Button android:id="@+id/btn9" style="@style/PinDialogDisc" android:text="9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnClearPin"
                style="@style/PinDialogDisc"
                android:text="CLR"
                android:textColor="?attr/colorError"
                android:textSize="14sp" />

            <Button android:id="@+id/btn0" style="@style/PinDialogDisc" android:text="0" />

            <Button
                android:id="@+id/btnBackspace"
                style="@style/PinDialogDisc"
                android:text="⌫"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="22sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPin"
            style="@style/Widget.BankALDeir.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="Confirm PIN"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPin"
            style="@style/Widget.BankALDeir.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Cancel"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

</LinearLayout>
