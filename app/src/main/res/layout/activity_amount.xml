<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="24dp" android:gravity="center" android:background="@drawable/backsy">
    <ImageView
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/iconbank"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Wallet Topup"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add funds to your BANK-AL-DEIR wallet"
        android:textSize="16sp"
        android:textColor="#6B7280"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvCurrentBalance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Current Balance: $0.00"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#10B981"
        android:layout_marginBottom="16dp"/>

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etAmount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:hint="Amount in USD (e.g. 10.00)"
        android:inputType="numberDecimal|numberSigned"
        android:background="@drawable/edittext_background"
        android:backgroundTint="@color/white"
        android:textColor="@color/black"
        android:textColorHint="@color/gray"
        android:textSize="18sp"
        android:padding="16dp"
        android:elevation="2dp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnPayPal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/paypal_btn"
        android:drawableStart="@drawable/paypal"
        android:drawablePadding="-55dp"
        android:paddingStart="55dp"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:text="Topup with PayPal"
        android:textColor="@android:color/black"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secure payment via PayPal"
        android:textSize="14sp"
        android:textColor="#6B7280"
        android:layout_marginTop="16dp"/>
</LinearLayout>