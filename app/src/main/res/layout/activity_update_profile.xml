<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backsy"
    tools:context=".updateProfile.updateProfile">

    <ScrollView
        android:id="@+id/ScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── Header ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="4dp"
                android:layout_marginTop="46dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/ic_bg_income"
                    android:padding="7dp"
                    android:scaleType="fitCenter"
                    app:srcCompat="@drawable/iconbank"
                    app:shapeAppearanceOverlay="@style/RoundSqaure" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit Information"
                        android:textColor="#4edea3"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Update your personal details"
                        android:textColor="#7a9e8e"
                        android:textSize="13sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── Profile Image Section ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <!-- Avatar with camera button overlay -->
                <FrameLayout
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:layout_marginBottom="16dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/profileImage"
                        android:layout_width="128dp"
                        android:layout_height="128dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/profile"
                        app:shapeAppearanceOverlay="@style/circuler"
                        app:strokeColor="#4edea3"
                        app:strokeWidth="3dp" />

                    <!-- Camera FAB overlay -->
                    <FrameLayout
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/btnedit">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:src="@drawable/camera"
                            app:tint="#FFFFFF" />

                    </FrameLayout>

                </FrameLayout>

                <!-- Current name display -->
                <TextView
                    android:id="@+id/txtName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Name"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="2dp" />

                <!-- Current email display -->
                <TextView
                    android:id="@+id/txtEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Email"
                    android:textColor="#7a9e8e"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp" />

                <!-- Pick image text button -->
                <Button
                    android:id="@+id/btnPickImage"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/card_type_bg"
                    android:drawableStart="@drawable/camera"
                    android:drawableTint="#4edea3"
                    android:drawablePadding="8dp"
                    android:paddingHorizontal="20dp"
                    android:text="PICK IMAGE"
                    android:textColor="#4edea3"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />

            </LinearLayout>

            <!-- ── Form Card ── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_type_bg"
                    android:padding="20dp">

                    <!-- First Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FIRST NAME"
                        android:textColor="#4a7a6a"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/edtFirstNameUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/edt_emerald"
                        android:paddingHorizontal="16dp"
                        android:inputType="textPersonName"
                        android:imeOptions="actionNext"
                        android:text="Example"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:hint="Enter first name"
                        android:textColorHint="#3f5a50"
                        android:layout_marginBottom="20dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1a3d2e"
                        android:layout_marginBottom="20dp" />

                    <!-- Last Name -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LAST NAME"
                        android:textColor="#4a7a6a"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/edtLastNameUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/edt_emerald"
                        android:paddingHorizontal="16dp"
                        android:inputType="textPersonName"
                        android:imeOptions="actionNext"
                        android:text="Example"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:hint="Enter last name"
                        android:textColorHint="#3f5a50"
                        android:layout_marginBottom="20dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#1a3d2e"
                        android:layout_marginBottom="20dp" />

                    <!-- Phone Number -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PHONE NUMBER"
                        android:textColor="#4a7a6a"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.12"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/edtPhoneNumberUpdate"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:background="@drawable/edt_emerald"
                        android:paddingHorizontal="16dp"
                        android:inputType="phone"
                        android:imeOptions="actionDone"
                        android:text="Example"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:hint="+1 (555) 000-0000"
                        android:textColorHint="#3f5a50" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- ── Info Note ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/tertiary_badge_bg"
                android:padding="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_info"
                    app:tint="#ffb95f" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Changing your primary phone number requires a quick identity verification for security."
                    android:textColor="#c2935a"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- ── Action Buttons ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginHorizontal="16dp"
                android:layout_marginBottom="40dp">

                <Button
                    android:id="@+id/btnCancelUpdate"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/send_field_card"
                    android:text="Cancel"
                    android:textColor="#7a9e8e"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSaveUpdate"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btnedit"
                    android:text="Save Changes"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
