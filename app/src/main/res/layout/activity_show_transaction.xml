<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ShowTransaction.ShowTransaction"
    android:background="@drawable/backsy">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" >

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:layout_marginTop="48dp"
                android:layout_marginBottom="16dp"
                app:srcCompat="@drawable/iconbank" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="600dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/show_back"
                android:backgroundTint="#1E1E2F"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/check_show_back">

                    <ImageView
                        android:id="@+id/imageView5"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/checkshow"/>
                </FrameLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="50dp"
                    android:layout_marginEnd="50dp"
                    android:layout_marginTop="16dp">

                    <TextView
                        android:id="@+id/typeTransactionTxt"
                        android:layout_width="200dp"
                        android:layout_height="40dp"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:text="PayPal TopUp"
                        android:textColor="@color/Success_Green"
                        android:textSize="26sp"
                        android:background="@drawable/back_plp"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/txtAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="+$00.00"
                    android:textColor="@color/Success_Green"
                    android:textSize="36sp"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"
                    android:layout_marginTop="16dp"/>

                <ImageView
                    android:id="@+id/imageView7"
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    app:srcCompat="@drawable/backgroundwhiteandblack" />

                <TextView
                    android:id="@+id/textView27"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:text="Transaction Number"
                    android:textSize="18sp"
                    android:textColor="@color/gray_text"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/transactionNShow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:layout_marginStart="16dp"
                        android:text="PLP-000-000-000-0000-0000"
                        android:textColor="@color/white"
                        android:textSize="20sp"/>

                    <ImageView
                        android:id="@+id/CopyTransaction"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_marginEnd="16dp"
                        android:layout_weight="0.15"
                        app:srcCompat="@drawable/copy" />
                </LinearLayout>

                <TextView
                    android:id="@+id/text1111"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:text="Date and Time"
                    android:textSize="18sp"
                    android:textColor="@color/gray_text" />

                <TextView
                    android:id="@+id/DateShow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="Feb 4, 2026 at 2:30 AM"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/fromOrWalletTxt"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:text="From"
                    android:textSize="18sp"
                    android:textColor="@color/gray_text" />

                <TextView
                    android:id="@+id/FromShow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="PayPal-External"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/textView41"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:text="To Wallet"
                    android:textSize="18sp"
                    android:textColor="@color/gray_text" />

                <TextView
                    android:id="@+id/toWalletShow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="WAL-8F42B1C3"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView42"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.75"
                        android:layout_marginStart="16dp"
                        android:text="Status"
                        android:layout_gravity="center"
                        android:textSize="18sp"
                        android:textColor="@color/gray_text" />

                    <TextView
                        android:id="@+id/textView46"
                        android:layout_width="0dp"
                        android:layout_height="30dp"
                        android:layout_weight="0.25"
                        android:layout_marginEnd="16dp"
                        android:text="Completed"
                        android:gravity="center"
                        android:textColor="@color/green_dark"
                        android:textSize="16sp"
                        android:background="@drawable/check_show_back"/>
                </LinearLayout>


            </LinearLayout>

            <Button
                android:id="@+id/btnBackShow"
                android:layout_width="match_parent"
                android:layout_marginStart="26dp"
                android:layout_marginEnd="26sp"
                android:layout_marginTop="20dp"
                android:layout_height="50dp"
                android:textSize="20sp"
                android:text="back"
                android:background="@drawable/btnedit"/>
            <Space
                android:layout_width="match_parent"
                android:layout_height="50dp" />
        </LinearLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>