<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/fatora_layout_anim"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="28dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Electricity"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="24dp"
                android:text="Select your provider, then enter the bill."
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <TextView style="@style/FatoraFieldLabel" android:text="Provider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/cardGreenEnergy"
                    style="@style/FatoraSelectCard"
                    android:layout_marginEnd="6dp">

                    <ImageView
                        android:id="@+id/greenEnergyCheckIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="invisible"
                        app:tint="?attr/colorPrimary" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/green_energy"
                        app:shapeAppearanceOverlay="@style/RoundSqaure" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Green Energy"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/cardMinistryElectricity"
                    style="@style/FatoraSelectCard"
                    android:layout_marginStart="6dp">

                    <ImageView
                        android:id="@+id/ministryCheckIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="end"
                        android:src="@drawable/ic_check_circle"
                        android:visibility="invisible"
                        app:tint="?attr/colorPrimary" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ministry_of_electricity"
                        app:shapeAppearanceOverlay="@style/RoundSqaure" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Ministry of Electricity"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/FatoraFieldLabel" android:text="Bill number" />

            <EditText
                android:id="@+id/billNumberEditText"
                style="@style/FatoraInput"
                android:drawableStart="@drawable/ic_receipt"
                android:hint="9-digit bill number"
                android:inputType="number"
                android:maxLength="9" />

            <TextView style="@style/FatoraFieldLabel" android:text="Amount" />

            <EditText
                android:id="@+id/amountEditText"
                style="@style/FatoraInput"
                android:drawableStart="@drawable/ic_money"
                android:hint="Bill amount"
                android:inputType="numberDecimal" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="The bill number is the 9-digit code printed on your electricity bill."
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/continueButton"
        style="@style/Widget.BankALDeir.Button"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="20dp"
        android:text="Continue to payment"
        app:cornerRadius="14dp" />

</LinearLayout>
