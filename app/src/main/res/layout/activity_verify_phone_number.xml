<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backsy"
    tools:context=".Login.VerifyPhoneNumber">

    <ProgressBar
        android:id="@+id/progressBar2"
        style="@android:style/Widget.ProgressBar.Large"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:indeterminateTint="#4edea3"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <!-- ── Header ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="20dp"
                android:paddingBottom="8dp"
                android:layout_marginTop="36dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/ic_bg_income"
                    android:layout_marginEnd="12dp">

                    <ImageView
                        android:id="@+id/imageView4"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/iconbank" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/textView4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bank Al-Deir"
                        android:textColor="#4edea3"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/textView5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SECURE VERIFICATION"
                        android:textColor="#7a9e8e"
                        android:textSize="11sp"
                        android:letterSpacing="0.1" />

                </LinearLayout>

            </LinearLayout>

            <!-- ── Phone icon ── -->
            <FrameLayout
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/check_show_back">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_phone"
                    app:tint="#4edea3" />

            </FrameLayout>

            <!-- ── Title ── -->
            <TextView
                android:id="@+id/textView12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Verification"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- ── Subtitle ── -->
            <TextView
                android:id="@+id/textView11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Please enter the OTP we sent to"
                android:textColor="#7a9e8e"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- ── Phone display ── -->
            <TextView
                android:id="@+id/showPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#4edea3"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="36dp" />

            <!-- ── OTP boxes ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <EditText
                    android:id="@+id/phoneOtp1"
                    android:layout_width="48dp"
                    android:layout_height="58dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/otp_box"
                    android:gravity="center"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#4edea3"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/phoneOtp2"
                    android:layout_width="48dp"
                    android:layout_height="58dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/otp_box"
                    android:gravity="center"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#4edea3"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/phoneOtp3"
                    android:layout_width="48dp"
                    android:layout_height="58dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/otp_box"
                    android:gravity="center"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#4edea3"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/phoneOtp4"
                    android:layout_width="48dp"
                    android:layout_height="58dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/otp_box"
                    android:gravity="center"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#4edea3"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/phoneOtp5"
                    android:layout_width="48dp"
                    android:layout_height="58dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/otp_box"
                    android:gravity="center"
                    android:imeOptions="actionNext"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#4edea3"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/phoneOtp6"
                    android:layout_width="48dp"
                    android:layout_height="58dp"
                    android:layout_marginHorizontal="5dp"
                    android:background="@drawable/otp_box"
                    android:gravity="center"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="1"
                    android:textColor="#4edea3"
                    android:textSize="22sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ── Resend row ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Didn't receive the OTP? "
                    android:textColor="#4a7a6a"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btnResendOtpPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resend"
                    android:textColor="#4edea3"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ── Info note ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="top"
                android:background="@drawable/card_type_bg"
                android:padding="16dp"
                android:layout_marginBottom="28dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginTop="1dp"
                    android:src="@drawable/ic_info"
                    app:tint="#ffb95f" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="This code is valid for 10 minutes. Never share it with anyone."
                    android:textColor="#c2935a"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />

            </LinearLayout>

            <!-- ── Login button ── -->
            <Button
                android:id="@+id/btnLoginAfterOTPPhone"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/btnedit"
                android:text="VERIFY &amp; LOG IN"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="32dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
