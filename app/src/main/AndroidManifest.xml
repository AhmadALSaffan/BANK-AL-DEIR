<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.RECEIVE_SMS"
        tools:ignore="PermissionImpliesUnsupportedChromeOsHardware" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BankALDeir">
        <activity
            android:name=".Fatora.UI.FatoraPayActivity"
            android:exported="false" />
        <activity
            android:name=".History.HistoryActivity"
            android:exported="false" />
        <activity
            android:name=".ShowTransaction.ShowTransaction"
            android:exported="false" />
        <activity
            android:name=".AmountTopUp.AmountActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="bankaldeir.braintree" />
            </intent-filter>
        </activity>
        <activity
            android:name=".Login.RegisterUserDetails"
            android:exported="false" />
        <activity
            android:name=".Login.LoginWithPhoneNumber"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Login.VerifyPhoneNumber"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".Fatora.UI.FatoraMain"
            android:exported="false" />
        <activity
            android:name=".pinPage.createPinCode"
            android:exported="false" />
        <activity
            android:name=".pinPage.PinPage"
            android:exported="false" />
        <activity
            android:name=".CardVariant"
            android:exported="false" />
        <activity
            android:name=".updateProfile.updateProfile"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".cardShowDetailsAfterCreate"
            android:exported="false" />
        <activity
            android:name=".finalDetailsNewCard"
            android:exported="false" />
        <activity
            android:name=".createNewCard"
            android:exported="false" />
        <activity
            android:name=".cards"
            android:exported="false" />
        <activity
            android:name=".profilePage"
            android:exported="false" />
        <activity
            android:name=".sendmoney.sendMoney"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".recive.Recive"
            android:exported="false" />
        <activity
            android:name=".Signup.OTP_Page"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".Signup.SignUp"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainPage"
            android:exported="false" />
        <activity
            android:name=".Login.LoginPage"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>