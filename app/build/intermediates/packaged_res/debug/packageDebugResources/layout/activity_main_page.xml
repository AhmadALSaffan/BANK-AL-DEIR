<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".MainPage">

    <!-- Covers the screen when the app is backgrounded -->
    <LinearLayout
        android:id="@+id/shieldView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/colorSurface"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/shieldLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:src="@drawable/iconbank" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rootScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="112dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Home promo cards (Realtime DB `homeCards` node). Hidden until loaded. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/adsList"
                android:layout_width="match_parent"
                android:layout_height="164dp"
                android:layout_marginTop="24dp"
                android:clipToPadding="false"
                android:paddingStart="20dp"
                android:paddingEnd="8dp"
                android:visibility="gone"
                tools:listitem="@layout/ad_card_item" />

            <!-- Nameplate: the bank's enamel plaque. Oxblood field, brass legend,
                 porcelain engraved balance. -->
            <LinearLayout
                android:id="@+id/headerCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/enamel_plaque_oxblood"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingTop="22dp"
                android:paddingBottom="26dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/profileImageMain"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/circuler"
                            app:srcCompat="@drawable/profile"
                            app:strokeColor="@color/enamel_brass"
                            app:strokeWidth="1.5dp" />

                        <ProgressBar
                            android:id="@+id/progressBarProfileImage"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Welcome back"
                            android:textAppearance="?attr/textAppearanceLabelMedium"
                            android:textColor="@color/enamel_brass_light" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp">

                            <TextView
                                android:id="@+id/firstNamett"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="@color/porcelain_bright"
                                android:visibility="gone" />

                            <ProgressBar
                                android:id="@+id/progressBarName"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:indeterminateTint="@color/enamel_brass_light" />
                        </FrameLayout>
                    </LinearLayout>

                    <!-- Card details: contactless + chip -->
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="10dp"
                        android:alpha="0.9"
                        android:contentDescription="@null"
                        android:rotation="90"
                        android:src="@drawable/ic_contactless"
                        app:tint="@color/enamel_brass_light" />

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chip"
                        app:tint="@color/enamel_brass_light" />
                </LinearLayout>

                <!-- Brass sub-legend, tracked like a sign's second line -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:letterSpacing="0.14"
                    android:text="TOTAL BALANCE"
                    android:textAllCaps="true"
                    android:textAppearance="?attr/textAppearanceLabelSmall"
                    android:textColor="@color/enamel_brass_light"
                    android:textStyle="bold" />

                <FrameLayout
                    android:id="@+id/balanceCard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/balance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.01"
                        android:text="$0.00"
                        android:textAppearance="?attr/textAppearanceDisplaySmall"
                        android:textColor="@color/porcelain_bright"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <ProgressBar
                        android:id="@+id/progressBarBalance"
                        style="?android:attr/progressBarStyleSmall"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:indeterminateTint="@color/enamel_brass_light" />
                </FrameLayout>

                <!-- Hairline + account row (like an embossed card footer) -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="22dp"
                    android:background="#33F1E7D2" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.14"
                            android:text="ACCOUNT"
                            android:textColor="@color/enamel_brass_light"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtHeaderAccount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.14"
                            android:text="•••• ••••"
                            android:textColor="#E6F1E7D2"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="USD"
                        android:textColor="@color/enamel_brass_light"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Primary actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSend"
                    style="@style/Widget.BankALDeir.Button"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Send"
                    android:textSize="17sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_send_transfer"
                    app:iconGravity="textStart"
                    app:iconSize="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecive"
                    style="@style/Widget.BankALDeir.Button.Tonal"
                    android:layout_width="0dp"
                    android:layout_height="62dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Receive"
                    android:textSize="17sp"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_receive_income"
                    app:iconGravity="textStart"
                    app:iconSize="24dp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPayPal"
                style="@style/Widget.BankALDeir.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:text="Add money"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                app:cornerRadius="14dp"
                app:icon="@drawable/google_pay"
                app:iconGravity="textStart"
                app:iconSize="24dp"
                app:iconTint="@null" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp" />

            <!-- Shortcuts -->
            <LinearLayout
                android:id="@+id/quickActionsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:orientation="horizontal"
                android:weightSum="5">

                <LinearLayout
                    android:id="@+id/myCards"
                    style="@style/HomeShortcut">

                    <ImageView
                        style="@style/HomeShortcutIcon"
                        android:src="@drawable/card48" />

                    <TextView
                        style="@style/HomeShortcutLabel"
                        android:text="Cards" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/payWithQrCode"
                    style="@style/HomeShortcut">

                    <ImageView
                        style="@style/HomeShortcutIcon"
                        android:src="@drawable/scan64" />

                    <TextView
                        style="@style/HomeShortcutLabel"
                        android:text="Scan" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/payWithFatora"
                    style="@style/HomeShortcut">

                    <ImageView
                        style="@style/HomeShortcutIcon"
                        android:src="@drawable/fatora" />

                    <TextView
                        style="@style/HomeShortcutLabel"
                        android:text="Bills" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/quick_history"
                    style="@style/HomeShortcut">

                    <ImageView
                        style="@style/HomeShortcutIcon"
                        android:src="@drawable/historyclock" />

                    <TextView
                        style="@style/HomeShortcutLabel"
                        android:text="History" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/quick_profile"
                    style="@style/HomeShortcut">

                    <ImageView
                        style="@style/HomeShortcutIcon"
                        android:src="@drawable/profile" />

                    <TextView
                        style="@style/HomeShortcutLabel"
                        android:text="Profile" />
                </LinearLayout>
            </LinearLayout>

            <!-- Promotional banner, loaded from Firebase. Source art is 1376x767, so the
                 frame is locked to 16:9 and the image fills it edge to edge, uncropped. -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/bannerImg"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    app:layout_constraintDimensionRatio="H,16:9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:shapeAppearanceOverlay="@style/Roundcard" />

                <ProgressBar
                    android:id="@+id/progressBarBanner"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginVertical="70dp"
                    android:indeterminateTint="?attr/colorOnSurfaceVariant"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- This month -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="This month"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <ProgressBar
                    android:id="@+id/analyticsProgressBar"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:indeterminateTint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Received"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvIncome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="$0.00"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/incomeProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="0"
                        app:indicatorColor="?attr/colorPrimary"
                        app:trackColor="?attr/colorSurfaceContainerHigh"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="4dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spent"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvExpenses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="$0.00"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/expenseProgressBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="0"
                        app:indicatorColor="?attr/colorTertiary"
                        app:trackColor="?attr/colorSurfaceContainerHigh"
                        app:trackCornerRadius="2dp"
                        app:trackThickness="4dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvTotalTransactions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="14dp"
                android:text=""
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="28dp" />

            <!-- Recent activity -->
            <TextView
                android:id="@+id/historyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="24dp"
                android:text="Recent activity"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <ProgressBar
                android:id="@+id/progressBartran"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:indeterminateTint="?attr/colorOnSurfaceVariant" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/userList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clipToPadding="false"
                android:visibility="gone"
                tools:listitem="@layout/trasnaction_item" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating bottom nav (shared) -->
    <include
        layout="@layout/floating_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="18dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
