        <activity
            android:name="bankal_deir.com.cards"
            android:exported="false" />
        <activity
            android:name="bankal_deir.com.profilePage"
            android:exported="false" />
        <activity
            android:name="bankal_deir.com.sendmoney.sendMoney"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="bankal_deir.com.recive.Recive"
            android:exported="false" />
        <activity
            android:name="bankal_deir.com.Signup.OTP_Page"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="bankal_deir.com.Signup.SignUp"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="bankal_deir.com.MainPage"
            android:exported="false" />
        <activity
            android:name="bankal_deir.com.Login.LoginPage"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="bankal_deir.com.MainActivity"
            android:exported="true" >
        </activity>
