                     stripped: "bankal_deir.com" -> "bankaldeir.com.braintree".
                -->
                <data android:scheme="bankaldeir.com.braintree" />
            </intent-filter>
        </activity>
        <activity
            android:name="bankal_deir.com.Login.RegisterUserDetails"
            android:exported="false" />
